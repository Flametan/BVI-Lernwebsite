<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_glass" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:orientation="vertical">
    <TextView
        android:id="@+id/eyebrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="● JETZT"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.0"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Vorbeugender Brandschutz"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="18sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="18sp"/>
    <TextView
        android:id="@+id/range"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="08:00–09:30"
        android:textColor="#F3F1EC"
        android:textStyle="normal"
        android:textSize="13sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13sp"/>
    <TextView
        android:id="@+id/room"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 2.14"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="13sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13sp"
        android:drawableStart="@drawable/ic_pin"
        android:drawablePadding="4dp"/>
    <TextView
        android:id="@+id/left"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="noch 30 min"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="12sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"/>
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/card" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp">
      <ImageView android:id="@+id/cardBg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_card" android:tint="#26272B" android:importantForAccessibility="no"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
    <TextView
        android:id="@+id/afterLabel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="DANACH"
        android:textColor="#A6A39B"
        android:textStyle="bold"
        android:textSize="10sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="10sp"/>
    <TextView
        android:id="@+id/afterTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.6"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Stabsarbeit"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="14sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="14sp"/>
    <TextView
        android:id="@+id/afterRange"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="09:45–11:15"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
    <TextView
        android:id="@+id/afterRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 1.03"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"
        android:drawableStart="@drawable/ic_pin"
        android:drawablePadding="4dp"/>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
