<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg" android:tint="#1B1C1F" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="13dp">
    <TextView
        android:id="@+id/eyebrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="● JETZT"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.0"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Vorbeugender Brandschutz"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="15sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="15sp"/>
    <TextView
        android:id="@+id/range"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="08:00–09:30"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="22sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="22sp"/>
    <TextView
        android:id="@+id/room"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 2.14"
        android:textColor="#A6A39B"
        android:textStyle="bold"
        android:textSize="12sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"
        android:drawableStart="@drawable/ic_pin"
        android:drawablePadding="4dp"/>
    <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="5dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/after" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3.4" android:orientation="vertical">
    <TextView
        android:id="@+id/afterTitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.0"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Danach 09:45 Stabsarbeit"
        android:textColor="#F3F1EC"
        android:textStyle="normal"
        android:textSize="11.5sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11.5sp"/>
    <TextView
        android:id="@+id/afterRoom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 1.03"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
