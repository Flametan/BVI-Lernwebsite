<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg" android:tint="#1B1C1F" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="11dp" android:paddingBottom="11dp">
    <TextView
        android:id="@+id/eyebrow"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="HEUTE IM PLAN"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
    <FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp">
      <ImageView android:id="@+id/rowBg1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_card" android:tint="#FFA412" android:importantForAccessibility="no"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center_vertical">
    <TextView
        android:id="@+id/time1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="08:00–09:30"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="13sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:orientation="vertical" android:paddingStart="6dp">
    <TextView
        android:id="@+id/title1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Vorbeugender Brandschutz"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="13.5sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13.5sp"/>
    <TextView
        android:id="@+id/sub1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="bis 09:30 · noch 30 min"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
          <ImageView android:id="@+id/bar1" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginBottom="2dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        </LinearLayout>
    <TextView
        android:id="@+id/room1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 2.14"
        android:textColor="#111111"
        android:textStyle="normal"
        android:textSize="12sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"/>
      </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp">
      <ImageView android:id="@+id/rowBg2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_card" android:tint="#26272B" android:importantForAccessibility="no"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center_vertical">
    <TextView
        android:id="@+id/time2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="08:00–09:30"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="13sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:orientation="vertical" android:paddingStart="6dp">
    <TextView
        android:id="@+id/title2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Vorbeugender Brandschutz"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="13.5sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13.5sp"/>
    <TextView
        android:id="@+id/sub2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="bis 09:30 · noch 30 min"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
          <ImageView android:id="@+id/bar2" android:visibility="gone" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginBottom="2dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        </LinearLayout>
    <TextView
        android:id="@+id/room2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 2.14"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="12sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"/>
      </LinearLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp">
      <ImageView android:id="@+id/rowBg3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_card" android:tint="#26272B" android:importantForAccessibility="no"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:gravity="center_vertical">
    <TextView
        android:id="@+id/time3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="08:00–09:30"
        android:textColor="#FFA412"
        android:textStyle="bold"
        android:textSize="13sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:orientation="vertical" android:paddingStart="6dp">
    <TextView
        android:id="@+id/title3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Vorbeugender Brandschutz"
        android:textColor="#F3F1EC"
        android:textStyle="bold"
        android:textSize="13.5sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="13.5sp"/>
    <TextView
        android:id="@+id/sub3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="bis 09:30 · noch 30 min"
        android:textColor="#111111"
        android:textStyle="bold"
        android:textSize="11sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="11sp"/>
          <ImageView android:id="@+id/bar3" android:visibility="gone" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginBottom="2dp" android:scaleType="fitXY" android:importantForAccessibility="no"/>
        </LinearLayout>
    <TextView
        android:id="@+id/room3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Raum 2.14"
        android:textColor="#A6A39B"
        android:textStyle="normal"
        android:textSize="12sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"/>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
